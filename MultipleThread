
class ThreadDemo extends Thread{
     private String task;

     public ThreadDemo(String task){
         this.task = task;
     }

     @Override
    public void run(){
         for (int i = 0; i <= 5; i++) {
             System.out.println(
                     Thread.currentThread().getName() + "-> " + task+ " : "+ i
             );

             try{
                 Thread.sleep(500);
             }catch (InterruptedException e){
                 e.printStackTrace();
             }
         }
     }
}
class MyRunnable implements Runnable{
    private String task;

    public MyRunnable(String task){
        this.task = task;
    }

    @Override
    public void run(){
        for (int i = 0; i <= 5; i++) {
            System.out.println(
                    Thread.currentThread().getName() + " -> " + task + " : " + i
            );

            try {
                Thread.sleep(500);
            }catch (InterruptedException e){
                e.printStackTrace();
            }
        }
    }
}

public class MultipleThreadExample{
    public static void main(String[] args) {
        //creating threads using Threads class
        ThreadDemo t1 = new ThreadDemo("Download File");
        ThreadDemo t2 = new ThreadDemo("Play music");

        //Creating threads using runnable interface
        Thread t3 = new Thread(new MyRunnable("Send Email")
        );

        Thread t4 = new Thread(new MyRunnable("Generate report")
        );
        //Giving names to threads
        t1.setName("Thread-1");
        t2.setName("Thread-2");
        t3.setName("Thread-3");
        t4.setName("Thread-4");


        //Starting all threads
        t1.start();
        t2.start();
        t3.start();
        t4.start();
    }
}
